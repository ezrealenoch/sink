project: my-project
project_id: 00000000-0000-0000-0000-000000000000   # generated by `sink init`; same value on every machine
version: 2
heartbeat_seconds: 30
poll_seconds: 10

# Pick ONE transport block.

transport:
  type: shared-fs
  path: shared                              # relative to each machine's sink_dir; works on Windows + Linux

# transport:
#   type: ssh
#   remote_path: /home/<user>/<project>/.sink   # uniform path on every peer
#   peers:
#     gpu-box: <user>@<host>:22
#     vm:      <user>@<vm-host>:22

# transport:
#   type: git
#   remote: <user>@<hub>:~/sink-repos/<project>.git
#   branch: main

agents:
  host:
    role: Workstation - editing, IDE work
    capabilities: [edit, research]
  vm:
    role: Linux VM - long-running tasks
    capabilities: [compile, build, test]
    ssh: <user>@<vm-host>:22                # informational; rendered in `sink status`
    sink_dir: /home/<user>/<project>/.sink
  gpu-box:
    role: Cloud GPU - training, inference
    capabilities: [cuda, gpu-inference]
    ssh: <user>@<gpu-host>:22
    sink_dir: /workspace/<project>/.sink
